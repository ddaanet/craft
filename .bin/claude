#!/usr/bin/env sh
# Dev launcher shim: prepend `--plugin-dir <copy of the plugin>` so the
# in-tree plugin is active without remembering the flag. On PATH via
# `.envrc` (`PATH_add .bin`). Chains to the next `claude` on PATH (e.g.
# gitlore's launcher shim) with our own dir stripped from PATH — the
# gitlore shim resolves *its* next claude against the inherited PATH, so
# leaving ourselves on it would make the two shims exec each other forever.
#
# The plugin dir is a copy under `dist/plugin/`, refreshed at each launch,
# not the repo root: Claude Code treats every path under a --plugin-dir
# root as a sensitive file, so with the root loaded every Edit or Write in
# the tree asks, and auto mode's classifier gives no verdict. Stopgap until the
# toolkit ships its dist-copy launcher. Skill edits reach a session only
# at its next launch.

unset CDPATH   # else `cd` may echo the target, corrupting the capture below
self=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$self")
dist="$root/dist/plugin"
{ rm -rf "$dist" && mkdir -p "$dist" \
  && cp -R "$root/.claude-plugin" "$root/skills" "$dist/"; } \
  || { echo "claude shim: could not copy the plugin to $dist" >&2; exit 1; }
newpath=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$self" | paste -sd: -)
real=$(PATH="$newpath" command -v claude) \
  || { echo "claude shim: no real claude on PATH" >&2; exit 127; }
PATH="$newpath" exec "$real" --plugin-dir "$dist" "$@"
